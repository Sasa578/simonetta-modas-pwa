# ============================================================
# Simonetta Modas — .gitignore
# ============================================================

# Dependencias
node_modules/

# Builds
dist/
build/

# Variables de entorno (contienen secretos y credenciales)
.env
.env.local
.env.*.local

# Logs
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Sistema operativo
.DS_Store
Thumbs.db
desktop.ini

# Editor / IDE
.vscode/
.idea/
*.swp
*.swo
*~

# Archivos de bloqueo de skills (si aplica)
skills-lock.json
